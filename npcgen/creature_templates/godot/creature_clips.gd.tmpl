extends RefCounted
## Which clip of this creature's pack plays for each thing a unit is doing. NPC Forge writes this file from the game's clip map
## for the creature's body plan (the Projects panel): the states are what a unit does, the values are the clip names in the model.
## A state with no clip in the map plays nothing.
## Generated by NPC Forge (npcgen/creature_templates/godot/creature_clips.gd.tmpl): change the game's clip map, then export again.
## No class_name: Godot gives a name that two scripts share to one of them, silently. Load this file by path, as creature_pack.gd is loaded.

const MAP := __CLIP_MAP__


## The clip that plays for `state`, or "" when the map has none for it.
static func clip_for(state: String) -> String:
	return MAP.get(state, "")
