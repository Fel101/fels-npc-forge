extends RefCounted
## A creature made in NPC Forge, read from its pack folder: model.glb, concept.png (when there is one), manifest.json and this
## loader/ folder. The manifest says what the model is: metres, +Y up, +Z forward, the bottom of the body on Y = 0, the bones and
## the clips. A game reads it here and then plays the clips it needs by name (loader/creature_clips.gd maps them).
## Generated by NPC Forge (npcgen/creature_templates/godot/creature_pack.gd): change the template, then export the pack again.
## No class_name: a game loads this file by path, so two packs in one project cannot share a name silently.
##   const CreaturePack := preload("res://assets/creatures/<name>/pack/loader/creature_pack.gd")

const SCHEMA := "npcforge.creature-pack/1"


## The manifest as a Dictionary, or an empty one when the folder holds no creature pack (a warning is printed).
static func read_manifest(folder: String) -> Dictionary:
	var file := FileAccess.open(folder.path_join("manifest.json"), FileAccess.READ)
	if file == null:
		push_warning("No manifest.json in %s" % folder)
		return {}
	var data = JSON.parse_string(file.get_as_text())
	if typeof(data) != TYPE_DICTIONARY or data.get("schema", "") != SCHEMA:
		push_warning("%s is not a creature pack" % folder)
		return {}
	return data


## A new instance of the pack's model, or null when the pack has none. A folder Godot does not import (a build folder with a
## .gdignore) is read as glTF at run time.
static func instance_model(folder: String) -> Node3D:
	var path := folder.path_join("model.glb")
	if ResourceLoader.exists(path):
		var packed := load(path) as PackedScene
		if packed != null:
			var model: Node3D = packed.instantiate()
			return model
	if not FileAccess.file_exists(path):
		return null
	var doc := GLTFDocument.new()
	var state := GLTFState.new()
	if doc.append_from_file(ProjectSettings.globalize_path(path), state) != OK:
		return null
	return doc.generate_scene(state) as Node3D
