extends SceneTree
## The creature pack this folder belongs to, checked headless: the manifest is a creature pack in metres, +Y up and +Z forward; the
## model has every clip the clip map names; its bones match the manifest; its bounds match the manifest's size; and its triangles
## are within the game's budget (the manifest's tri_budget, when the pack records one).
## Generated by NPC Forge (npcgen/creature_templates/godot/creature_pack_test.gd). Run it from the game folder, with the pack's folder
## after the --:
##   godot --headless --path . --script res://assets/creatures/<name>/pack/loader/creature_pack_test.gd -- res://assets/creatures/<name>/pack
## With no pack folder, or no creature pack in it, the test says so and exits 0 (skipped). It exits 1 when a check fails.

const CreaturePackLoader := preload("creature_pack.gd")
const ClipsLoader := preload("creature_clips.gd")
const SIZE_TOLERANCE := 0.02          # metres

var _failures := 0
var _checks := 0


func _check(cond: bool, msg: String) -> void:
	_checks += 1
	if not cond:
		_failures += 1
	print("%s  %s" % ["ok  " if cond else "FAIL", msg])


func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	if args.is_empty():
		print("SKIP: give the pack folder after -- (for example res://assets/creatures/<name>/pack)")
		quit(0)
		return
	var pack: String = args[0]
	var manifest: Dictionary = CreaturePackLoader.read_manifest(pack)
	if manifest.is_empty():
		print("SKIP: no creature pack in %s" % pack)
		quit(0)
		return
	_check(manifest.get("schema", "") == CreaturePackLoader.SCHEMA, "the pack has a creature manifest")
	_check(manifest.get("units", "") == "metres" and manifest.get("up", "") == "+Y" and manifest.get("forward", "") == "+Z",
		"units are metres, up is +Y, forward is +Z")
	var size: Array = manifest.get("size_m", [])
	_check(size.size() == 3, "the manifest gives a size")
	var clips: Array = manifest.get("clips", [])
	for state in ClipsLoader.MAP:
		var clip: String = ClipsLoader.MAP[state]
		_check(clip in clips, "the manifest lists the %s clip (%s)" % [clip, state])
	_check(ClipsLoader.clip_for("fly") == "", "a state the map does not name plays nothing")

	var model := CreaturePackLoader.instance_model(pack)
	_check(model != null, "the pack has a model")
	if model != null:
		root.add_child(model)
		_check_model(model, manifest, size)
		model.queue_free()
	_finish()


func _check_model(model: Node3D, manifest: Dictionary, size: Array) -> void:
	var players: Array = []
	var skeletons: Array = []
	var meshes: Array = []
	_collect(model, players, skeletons, meshes)
	if not ClipsLoader.MAP.is_empty():
		_check(players.size() > 0, "the model has an animation player")
	for state in ClipsLoader.MAP:
		var clip: String = ClipsLoader.MAP[state]
		_check(players.size() > 0 and players[0].has_animation(clip), "the model has the %s clip for %s" % [clip, state])
	var bones := 0
	for skeleton in skeletons:
		bones += skeleton.get_bone_count()
	if manifest.has("bones"):
		_check(bones == int(manifest["bones"]), "the model has the manifest's %d bones" % int(manifest["bones"]))

	var triangles := 0
	var box := AABB()
	var first := true
	for mesh_instance in meshes:
		var mesh: Mesh = mesh_instance.mesh
		for surface in range(mesh.get_surface_count()):
			var indices: int = mesh.surface_get_array_index_len(surface)
			triangles += (indices if indices > 0 else mesh.surface_get_array_len(surface)) / 3
		var moved: AABB = _to_model(mesh_instance, model) * mesh_instance.get_aabb()
		box = moved if first else box.merge(moved)
		first = false
	_check(triangles > 0, "the model has triangles")
	if manifest.has("tri_budget"):
		var budget := int(manifest["tri_budget"])
		_check(triangles <= budget, "the model has %d triangles, within the %d budget" % [triangles, budget])
	else:
		print("note  the pack records no triangle budget (it was made before the budget was written): not checked")
	if size.size() == 3:
		var fits := absf(box.size.x - float(size[0])) < SIZE_TOLERANCE and absf(box.size.y - float(size[1])) < SIZE_TOLERANCE \
			and absf(box.size.z - float(size[2])) < SIZE_TOLERANCE
		_check(fits, "the model's bounds %s match the manifest's %s" % [str(box.size), str(size)])


func _finish() -> void:
	print("%d checks, %d failed" % [_checks, _failures])
	quit(1 if _failures > 0 else 0)


## The node's transform inside the model, built from the transforms up to the model (no tree needed).
func _to_model(node: Node3D, model: Node3D) -> Transform3D:
	var result := Transform3D.IDENTITY
	var current: Node3D = node
	while current != null and current != model:
		result = current.transform * result
		current = current.get_parent() as Node3D
	return result


func _collect(node: Node, players: Array, skeletons: Array, meshes: Array) -> void:
	if node is AnimationPlayer:
		players.append(node)
	if node is Skeleton3D:
		skeletons.append(node)
	if node is MeshInstance3D:
		meshes.append(node)
	for child in node.get_children():
		_collect(child, players, skeletons, meshes)
