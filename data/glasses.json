{
  "_readme": "What the glasses maker (npcgen/glasses.py) offers. Glasses are built from measurements, not from a picture: image-to-3D cannot make a frame a millimetre and a half thick or a lens with no surface to find. Sizes are in millimetres, as an optician gives them: `lens_w` and `lens_h` are the box a lens fits in, `bridge` is the gap between the two lens boxes, `temple_len` the arm from its hinge to its tip. A preset is a style (shape, frame, arms): applying one sets those fields and leaves the lenses as they are. `fields` are the numbers the editor shows and the server checks (min, max, default comes from `defaults`); `choices` are the lists; `colours` and `tints` are the swatches. Read fresh on every request.",
  "defaults": {
    "shape": "classic", "lens_w": 52, "lens_h": 42, "bridge": 19, "bridge_style": "arch", "bridge_height": 0.22, "rim": "full", "rim_w": 5.2,
    "rim_d": 5.0, "brow_w": 6.0, "frame_material": "plastic", "frame_color": "#17181b", "temple_len": 145, "temple_h": 7.5, "temple_w": 3.6,
    "temple_drop": 28, "temple_bend": 0.75, "splay": 2, "hinge_y": 0.3, "wrap": 5, "base_curve": 4, "pads": false, "lens_tint": "clear",
    "lens_color": "#f4f8fc", "lens_opacity": 0.07, "lens_finish": "glass", "lens_gradient": false, "pose": "open", "scale": 1.0, "preset": "classic"
  },
  "fields": {
