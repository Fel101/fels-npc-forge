    "bridge_height": {"label": "Bridge height", "unit": "× lens height", "min": 0, "max": 0.4, "step": 0.01, "group": "Frame"},
    "rim_w": {"label": "Rim thickness (seen from the front)", "unit": "mm", "min": 0.8, "max": 9, "step": 0.1, "group": "Frame"},
